# Settlr AI - Environment Configuration
PORT=3000

# Google Gemini API Key (Get from https://aistudio.google.com/)
# Note: If left blank, Settlr AI automatically runs with high-fidelity agent simulation mode!
GEMINI_API_KEY=

# PayPal Developer Sandbox Credentials (Get from https://developer.paypal.com/dashboard/applications/sandbox)
# Note: If left blank, Settlr AI operates in PayPal Sandbox Simulation mode!
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
